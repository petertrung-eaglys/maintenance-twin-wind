# Schema
@prefix geo: <http://www.w3.org/2003/01/geo/wgs84_pos#> .
@prefix kt: <https://example.org/wind-twin#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix qudt: <http://qudt.org/schema/qudt/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix sosa: <http://www.w3.org/ns/sosa/> .

kt:Alert a rdfs:Class ;
    rdfs:label "Alert" ;
    rdfs:comment "A residual-based component health alert." .

kt:Component a rdfs:Class ;
    rdfs:label "Component" ;
    rdfs:comment "Superclass for turbine parts." .

kt:Dataset a rdfs:Class ;
    rdfs:label "Dataset" ;
    rdfs:comment "A published dataset of one farm." ;
    rdfs:subClassOf prov:Entity .

kt:FaultEvent a rdfs:Class ;
    rdfs:label "Fault event" ;
    rdfs:comment "A labelled Stop/Warning event." .

kt:Gearbox a rdfs:Class ;
    rdfs:label "Gearbox" ;
    rdfs:comment "The drivetrain gearbox." ;
    rdfs:subClassOf kt:Component .

kt:Generator a rdfs:Class ;
    rdfs:label "Generator" ;
    rdfs:comment "The electrical generator." ;
    rdfs:subClassOf kt:Component .

kt:MainBearing a rdfs:Class ;
    rdfs:label "Main bearing" ;
    rdfs:comment "The rotor shaft bearing." ;
    rdfs:subClassOf kt:Component .

kt:Model a rdfs:Class ;
    rdfs:label "Model" ;
    rdfs:comment "A normal-behaviour model." ;
    rdfs:subClassOf prov:Entity .

kt:Nacelle a rdfs:Class ;
    rdfs:label "Nacelle" ;
    rdfs:comment "The nacelle and its sensors." ;
    rdfs:subClassOf kt:Component .

kt:PitchModel a rdfs:Class ;
    rdfs:label "Pitch model" ;
    rdfs:comment "Predicts the pitch angle." ;
    rdfs:subClassOf kt:Model .

kt:PitchSystem a rdfs:Class ;
    rdfs:label "Pitch system" ;
    rdfs:comment "Blade pitch drives." ;
    rdfs:subClassOf kt:Component .

kt:PowerModel a rdfs:Class ;
    rdfs:label "Power model" ;
    rdfs:comment "Predicts turbine power." ;
    rdfs:subClassOf kt:Model .

kt:Rotor a rdfs:Class ;
    rdfs:label "Rotor" ;
    rdfs:comment "The rotor with hub and blades." ;
    rdfs:subClassOf kt:Component .

kt:Sensor a rdfs:Class ;
    rdfs:label "Sensor" ;
    rdfs:comment "One SCADA signal of a turbine." ;
    rdfs:subClassOf sosa:Sensor .

kt:SourceFile a rdfs:Class ;
    rdfs:label "Source file" ;
    rdfs:comment "A raw file of a dataset." ;
    rdfs:subClassOf prov:Entity .

kt:ThermalModel a rdfs:Class ;
    rdfs:label "Thermal model" ;
    rdfs:comment "Predicts a temperature." ;
    rdfs:subClassOf kt:Model .

kt:Turbine a rdfs:Class ;
    rdfs:label "Turbine" ;
    rdfs:comment "One wind turbine." .

kt:WindFarm a rdfs:Class ;
    rdfs:label "Wind farm" ;
    rdfs:comment "A wind farm site." .

kt:YawModel a rdfs:Class ;
    rdfs:label "Yaw model" ;
    rdfs:comment "Estimates yaw misalignment." ;
    rdfs:subClassOf kt:Model .

kt:YawSystem a rdfs:Class ;
    rdfs:label "Yaw system" ;
    rdfs:comment "Nacelle yaw drives." ;
    rdfs:subClassOf kt:Component .

qudt:unit a rdf:Property ;
    rdfs:label "unit" ;
    rdfs:comment "QUDT unit of the signal." ;
    rdfs:domain kt:Sensor ;
    rdfs:range qudt:Unit .

geo:lat a rdf:Property ;
    rdfs:label "latitude" ;
    rdfs:comment "WGS84 latitude." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

geo:long a rdf:Property ;
    rdfs:label "longitude" ;
    rdfs:comment "WGS84 longitude." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

prov:wasDerivedFrom a rdf:Property ;
    rdfs:label "was derived from" ;
    rdfs:comment "Source." ;
    rdfs:domain prov:Entity ;
    rdfs:range prov:Entity .

sosa:observes a rdf:Property ;
    rdfs:label "observes" ;
    rdfs:comment "Quantity." ;
    rdfs:domain kt:Sensor ;
    rdfs:range sosa:ObservableProperty .

kt:affects a rdf:Property ;
    rdfs:label "affects" ;
    rdfs:comment "Faulty component." ;
    rdfs:domain kt:FaultEvent ;
    rdfs:range kt:Component .

kt:commissioningDate a rdf:Property ;
    rdfs:label "commissioning date" ;
    rdfs:comment "COD." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:componentKey a rdf:Property ;
    rdfs:label "component key" ;
    rdfs:comment "e.g. gearbox." ;
    rdfs:domain kt:Component ;
    rdfs:range rdfs:Literal .

kt:concerns a rdf:Property ;
    rdfs:label "concerns" ;
    rdfs:comment "Component alerted on." ;
    rdfs:domain kt:Alert ;
    rdfs:range kt:Component .

kt:doi a rdf:Property ;
    rdfs:label "DOI" ;
    rdfs:comment "Digital object identifier." ;
    rdfs:domain kt:Dataset ;
    rdfs:range rdfs:Literal .

kt:downloadUrl a rdf:Property ;
    rdfs:label "download URL" ;
    rdfs:comment "Zenodo URL." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range rdfs:Literal .

kt:endTime a rdf:Property ;
    rdfs:label "end time" ;
    rdfs:comment "End (UTC)." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal .

kt:eventCode a rdf:Property ;
    rdfs:label "code" ;
    rdfs:comment "Controller event code." ;
    rdfs:domain kt:FaultEvent ;
    rdfs:range rdfs:Literal .

kt:eventMessage a rdf:Property ;
    rdfs:label "message" ;
    rdfs:comment "Event message." ;
    rdfs:domain kt:FaultEvent ;
    rdfs:range rdfs:Literal .

kt:eventStatus a rdf:Property ;
    rdfs:label "status" ;
    rdfs:comment "Stop or Warning." ;
    rdfs:domain kt:FaultEvent ;
    rdfs:range rdfs:Literal .

kt:farmCode a rdf:Property ;
    rdfs:label "farm code" ;
    rdfs:comment "Short code, e.g. KLM." ;
    rdfs:domain kt:WindFarm ;
    rdfs:range rdfs:Literal .

kt:fileName a rdf:Property ;
    rdfs:label "file name" ;
    rdfs:comment "Raw file name." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range rdfs:Literal .

kt:greenbyteSignalId a rdf:Property ;
    rdfs:label "Greenbyte signal id" ;
    rdfs:comment "Mapping." ;
    rdfs:domain kt:Sensor ;
    rdfs:range rdfs:Literal .

kt:hasComponent a rdf:Property ;
    rdfs:label "has component" ;
    rdfs:comment "A part." ;
    rdfs:domain kt:Turbine ;
    rdfs:range kt:Component .

kt:hasInput a rdf:Property ;
    rdfs:label "has input" ;
    rdfs:comment "An input signal." ;
    rdfs:domain kt:Model ;
    rdfs:range kt:Sensor .

kt:hasSensor a rdf:Property ;
    rdfs:label "has sensor" ;
    rdfs:comment "A turbine sensor." ;
    rdfs:domain kt:Turbine ;
    rdfs:range kt:Sensor .

kt:hasTarget a rdf:Property ;
    rdfs:label "has target" ;
    rdfs:comment "The predicted signal." ;
    rdfs:domain kt:Model ;
    rdfs:range kt:Sensor .

kt:hasTurbine a rdf:Property ;
    rdfs:label "has turbine" ;
    rdfs:comment "A farm turbine." ;
    rdfs:domain kt:WindFarm ;
    rdfs:range kt:Turbine .

kt:hubHeightM a rdf:Property ;
    rdfs:label "hub height (m)" ;
    rdfs:comment "Hub height." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:iecCategory a rdf:Property ;
    rdfs:label "IEC category" ;
    rdfs:comment "IEC 61400-26." ;
    rdfs:domain kt:FaultEvent ;
    rdfs:range rdfs:Literal .

kt:leadTimeHours a rdf:Property ;
    rdfs:label "lead time (h)" ;
    rdfs:comment "Alert to event." ;
    rdfs:domain kt:Alert ;
    rdfs:range rdfs:Literal .

kt:license a rdf:Property ;
    rdfs:label "license" ;
    rdfs:comment "Dataset license." ;
    rdfs:domain kt:Dataset ;
    rdfs:range rdfs:Literal .

kt:mae a rdf:Property ;
    rdfs:label "MAE" ;
    rdfs:comment "Test MAE in the target's unit." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:manufacturer a rdf:Property ;
    rdfs:label "manufacturer" ;
    rdfs:comment "Maker." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:manufacturerTitle a rdf:Property ;
    rdfs:label "manufacturer title" ;
    rdfs:comment "Mapping." ;
    rdfs:domain kt:Sensor ;
    rdfs:range rdfs:Literal .

kt:md5 a rdf:Property ;
    rdfs:label "MD5" ;
    rdfs:comment "Checksum of the file." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range rdfs:Literal .

kt:modelFile a rdf:Property ;
    rdfs:label "model file" ;
    rdfs:comment "Saved model path." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:modelOf a rdf:Property ;
    rdfs:label "model of" ;
    rdfs:comment "Modelled component." ;
    rdfs:domain kt:Model ;
    rdfs:range kt:Component .

kt:modelVariant a rdf:Property ;
    rdfs:label "model variant" ;
    rdfs:comment "baseline, physics, hybrid or pinn." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:monitors a rdf:Property ;
    rdfs:label "monitors" ;
    rdfs:comment "Component observed." ;
    rdfs:domain kt:Sensor ;
    rdfs:range kt:Component .

kt:nTest a rdf:Property ;
    rdfs:label "test rows" ;
    rdfs:comment "Normal rows scored." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:nTrain a rdf:Property ;
    rdfs:label "train rows" ;
    rdfs:comment "Normal rows used to fit." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:nrmse a rdf:Property ;
    rdfs:label "nRMSE" ;
    rdfs:comment "RMSE / rated power (power), RMSE in degC (temperature)." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:partOf a rdf:Property ;
    rdfs:label "part of" ;
    rdfs:comment "Containing archive." ;
    rdfs:domain kt:SourceFile ;
    rdfs:range prov:Entity .

kt:precedes a rdf:Property ;
    rdfs:label "precedes" ;
    rdfs:comment "Anticipated event." ;
    rdfs:domain kt:Alert ;
    rdfs:range kt:FaultEvent .

kt:publisher a rdf:Property ;
    rdfs:label "publisher" ;
    rdfs:comment "Data owner." ;
    rdfs:domain kt:Dataset ;
    rdfs:range rdfs:Literal .

kt:raisedBy a rdf:Property ;
    rdfs:label "raised by" ;
    rdfs:comment "Model behind the alert." ;
    rdfs:domain kt:Alert ;
    rdfs:range kt:Model .

kt:ratedPowerKW a rdf:Property ;
    rdfs:label "rated power (kW)" ;
    rdfs:comment "Rated power." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:rmse a rdf:Property ;
    rdfs:label "RMSE" ;
    rdfs:comment "Test RMSE in the target's unit." ;
    rdfs:domain kt:Model ;
    rdfs:range rdfs:Literal .

kt:rotorDiameterM a rdf:Property ;
    rdfs:label "rotor diameter (m)" ;
    rdfs:comment "Diameter." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:scadaColumn a rdf:Property ;
    rdfs:label "SCADA column" ;
    rdfs:comment "Raw column name." ;
    rdfs:domain kt:Sensor ;
    rdfs:range rdfs:Literal .

kt:signalKey a rdf:Property ;
    rdfs:label "signal key" ;
    rdfs:comment "Parquet column name." ;
    rdfs:domain kt:Sensor ;
    rdfs:range rdfs:Literal .

kt:startTime a rdf:Property ;
    rdfs:label "start time" ;
    rdfs:comment "Start (UTC)." ;
    rdfs:domain rdfs:Resource ;
    rdfs:range rdfs:Literal .

kt:storedIn a rdf:Property ;
    rdfs:label "stored in" ;
    rdfs:comment "Parquet file path." ;
    rdfs:domain kt:Sensor ;
    rdfs:range rdfs:Literal .

kt:turbineId a rdf:Property ;
    rdfs:label "turbine id" ;
    rdfs:comment "Id in its farm, e.g. T01." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .

kt:turbineModel a rdf:Property ;
    rdfs:label "turbine model" ;
    rdfs:comment "e.g. MM92." ;
    rdfs:domain kt:Turbine ;
    rdfs:range rdfs:Literal .


